{
    "manifest_version": 3,
    "name": "PDF Query Assistant",
    "version": "1.0",
    "permissions": ["scripting", "activeTab", "downloads"],
    "host_permissions": ["http://localhost:8000/"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }